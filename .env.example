# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=3000

# MongoDB lokal:
MONGODB_URI=mongodb://127.0.0.1:27017/packing_pendakian
# MongoDB Atlas (contoh):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/packing_pendakian?retryWrites=true&w=majority

# Batas beban tas bawaan (kilogram) untuk endpoint ringkasan dan saran
BATAS_BERAT_KG=9
